{
  "name": "自动化任务调度配置",
  "version": "1.0",
  "tasks": [
    {
      "id": "daily_market_update",
      "name": "每日行情数据更新",
      "description": "每个交易日更新大盘指数和持仓股票行情",
      "cron": "0 9 * * 1-5",
      "enabled": true,
      "steps": ["data_collection", "update_lists"],
      "notify": false
    },
    {
      "id": "daily_report",
      "name": "每日新闻洞察生成",
      "description": "每个交易日早上生成每日新闻洞察报告",
      "cron": "0 8 * * 1-5",
      "enabled": true,
      "steps": ["generate_daily_report", "update_lists", "git_deploy"],
      "notify": true
    },
    {
      "id": "intraday_report",
      "name": "盘中快报生成",
      "description": "每个交易日午间生成盘中快报",
      "cron": "30 12 * * 1-5",
      "enabled": true,
      "steps": ["generate_intraday_report", "update_lists", "git_deploy"],
      "notify": true
    },
    {
      "id": "aftermarket_report",
      "name": "盘后速递生成",
      "description": "每个交易日收盘后生成盘后速递",
      "cron": "30 15 * * 1-5",
      "enabled": true,
      "steps": ["generate_aftermarket_report", "update_lists", "git_deploy"],
      "notify": true
    },
    {
      "id": "weekly_review",
      "name": "周复盘生成",
      "description": "每周六生成周度复盘报告",
      "cron": "0 9 * * 6",
      "enabled": true,
      "steps": ["generate_weekly_review", "update_lists", "git_deploy"],
      "notify": true
    },
    {
      "id": "weekly_outlook",
      "name": "周三前瞻生成",
      "description": "每周三生成前瞻报告",
      "cron": "0 8 * * 3",
      "enabled": true,
      "steps": ["generate_weekly_outlook", "update_lists", "git_deploy"],
      "notify": true
    },
    {
      "id": "daily_pro_pages",
      "name": "Pro页面每日更新",
      "description": "每日更新所有Pro工具页面数据",
      "cron": "0 6 * * *",
      "enabled": true,
      "steps": ["data_collection", "generate_pro_pages", "git_deploy"],
      "notify": false
    },
    {
      "id": "s_level_scan",
      "name": "S级催化扫描",
      "description": "每周扫描S级催化机会",
      "cron": "0 10 * * 0",
      "enabled": true,
      "steps": ["generate_s_level_catalyst", "update_lists", "git_deploy"],
      "notify": true
    }
  ]
}
